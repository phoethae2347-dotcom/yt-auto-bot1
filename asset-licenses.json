{
  "status": "dynamic",
  "source": "Openverse",
  "allowedLicenses": [
    "cc0"
  ],
  "apiUrl": "https://api.openverse.org/v1/images/",
  "licenseUrl": "https://creativecommons.org/publicdomain/zero/1.0/",
  "searchQueries": [
    "forest path nature landscape",
    "river valley nature landscape",
    "mountain lake landscape",
    "ocean coast sunset landscape",
    "quiet road landscape",
    "clouds sky sunset landscape",
    "woodland stream nature",
    "open field landscape"
  ],
  "rules": {
    "imagesPerVideo": 4,
    "neverReuseImageId": true,
    "excludeIdentifiablePeople": true,
    "requireSourcePageMetadata": true,
    "requireSha256": true
  },
  "credits": "Each run downloads fresh CC0 visuals from Openverse. The current run's creator, provider, source page, license, and SHA-256 records are written to .runtime/current-assets.json and included in the YouTube description."
}
